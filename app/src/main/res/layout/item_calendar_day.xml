<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_container"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_day_normal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_margin="2dp"
    android:padding="2dp">

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_water"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/dot_blue"
            android:visibility="gone" />

        <View
            android:id="@+id/dot_feeding"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/dot_green"
            android:visibility="gone" />

        <View
            android:id="@+id/dot_harvest"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/dot_red"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
